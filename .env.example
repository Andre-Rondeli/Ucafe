# Copie este arquivo para `.env` e preencha com o SEU projeto Supabase.
# Os dois valores estão no dashboard: Project Settings -> API.
# A chave anon (publishable) é pública por natureza — ela vai embutida no bundle do site.
# Quem protege o dado é a RLS do banco. A `service_role` NUNCA entra aqui.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=cole-aqui-a-publishable-key-do-dashboard
